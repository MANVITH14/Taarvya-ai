# ============================================================
# TAARVYA AI — Environment Variables Template
# Copy this file to .env (backend) and frontend/.env.local
# NEVER commit real credentials to version control
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/taarvya_ai
# For Neon: postgresql+asyncpg://user:password@ep-xxx.neon.tech/taarvya_ai?sslmode=require

# --- Security ---
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OpenAI (Optional — app works without this) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Email (Optional — for email verification / password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@taarvya.ai

# --- Geocoding ---
# Using OpenStreetMap Nominatim (free, no key required)
# Optional: Google Maps API for higher rate limits
GOOGLE_MAPS_API_KEY=

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://taarvya.ai

# --- Frontend (Vite) ---
# Only VITE_ prefix variables are exposed to the browser
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Taarvya AI

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
